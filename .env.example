# Copia este archivo como ".env" y completa los valores. ".env" nunca se sube al repositorio.
# Los nombres son una propuesta; la Fase 1 los confirma.

ENVIRONMENT=development
DATABASE_URL=sqlite:///./dev.db

# Genera un valor largo y aleatorio. No reutilices el de otro proyecto.
JWT_SECRET=
JWT_ISSUER=agro-xpace-api
JWT_AUDIENCE=agro-xpace-clients
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# Límite de intentos de registro/login por IP (ADR-002). En memoria, por proceso.
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Orígenes permitidos para la aplicación cliente, separados por coma. Nunca "*".
CORS_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1

# Límite de tamaño del cuerpo de la solicitud, en bytes (ver ADR-007). 1048576 = 1 MiB.
MAX_BODY_BYTES=1048576

# Pagos: "fake" en desarrollo. En producción, la pasarela real.
PAYMENT_PROVIDER=fake
PAYMENT_WEBHOOK_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
PUBLIC_BASE_URL=http://localhost:8000

# Fuentes de datos (ADR-005, ADR-009)
NASA_POWER_BASE_URL=https://power.larc.nasa.gov
FORECAST_BASE_URL=https://api.open-meteo.com
EXTERNAL_API_TIMEOUT_SECONDS=10
EXTERNAL_API_CACHE_TTL_SECONDS=3600
COORDINATE_ROUNDING_DECIMALS=2
